APP_NAME="Consulat Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de donnees MySQL 8 ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=consulat_platform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# --- Mail (log = les emails sont ecrits dans storage/logs) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@consulat-demo.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Frontend Next.js (liens emails, CORS) ---
FRONTEND_URL=http://localhost:3000
DATA_RETENTION_DAYS=365
BOOKING_CANCEL_MIN_HOURS=24
